# Environment Variables Template for AgriAdvisory Platform

# OpenWeatherMap API Key (optional - app will use mock data if not provided)
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Node Environment
NODE_ENV=production

# Public URL (automatically set by Render)
# RENDER_EXTERNAL_URL will be set automatically
